{
  "name": "compras-de-campo-pwa",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --configLoader native",
    "build:client": "tsc --noEmit && vite build --configLoader native",
    "build": "tsc --noEmit && vite build --configLoader native && node scripts/generate-worker-assets.mjs && vite build --config vite.worker.config.ts --configLoader native && node scripts/prepare-sites-dist.mjs",
    "preview": "vite preview --configLoader native",
    "check": "tsc --noEmit",
    "test": "node --test --test-isolation=none tests/auth.test.mjs"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "lucide-react": "1.28.0",
    "pdfjs-dist": "5.4.624",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@xmldom/xmldom": "^0.9.12",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "type": "module"
}
